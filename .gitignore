# Dependencies
node_modules/
.npm/

# OS files
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# Art files (Large binaries)
# We ignore the actual image files but keep the directory structure
art/*
!art/source/.gitkeep
!art/output/.gitkeep

# Logs
*.log
npm-debug.log*

# Build and local configs
dist/
.env
.env.local
.typescript-eslint-cache
